rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user owns everything under users/{uid}: their config, status, and
    // games. A signed-in user may read/write only their own subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
